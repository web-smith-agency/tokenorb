// Windows-Ressourcen: Icon, Manifest, Versionsinfo.
// Firmenname/Produktname hier anpassen, wenn du das Produkt umbenennst.
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
1 ICON "icon.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "CompanyName", "TokenOrb"
      VALUE "FileDescription", "TokenOrb - Nutzungsanzeige fuer Claude Code"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "TokenOrb"
      VALUE "LegalCopyright", "(c) 2026"
      VALUE "OriginalFilename", "TokenOrb.exe"
      VALUE "ProductName", "TokenOrb"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0407, 0x04B0
  END
END
